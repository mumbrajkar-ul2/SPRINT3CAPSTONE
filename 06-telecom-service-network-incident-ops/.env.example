DATABASE_URL=postgresql://app_shared:CHANGE_ME@localhost:5432/workshop
AI_GATEWAY_KEY=CHANGE_ME
LEGACY_BATCH_PASSWORD=CHANGE_ME
OT_VENDOR_TOKEN=CHANGE_ME
LOG_LEVEL=DEBUG
# S04-09. Seconds to wait for the model before the case goes to a person (HOLD_FOR_REVIEW).
# PROPOSED default 10. Owner: Team-Force. The code reads this name from the environment.
# A value that is empty, not a number, zero, or negative gives the default.
AI_MODEL_TIMEOUT_SECONDS=10
# S04-11. Breaker and in-flight limit for the model call. All three are PROPOSED. Owner: Team-Force.
# BREAKER_FAILURE_THRESHOLD is how many timeouts or errors in a row open the breaker. Default 5.
# BREAKER_OPEN_SECONDS is how long the breaker refuses model calls before one test call. Default 30.
# MODEL_MAX_IN_FLIGHT is how many model calls may run at once. Extra calls are held for review at once. Default 10.
# An empty, non-numeric, zero, or negative value gives the default.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_SECONDS=30
MODEL_MAX_IN_FLIGHT=10
# S04-12. Educational units per 1000 tokens. The rate docs/12-finops/metrics_from_audit.py applies to the
# `tokens` column. Value 1.0 decided on 2026-10-11 by Mangesh (FDE). Owner: Team-Force. EDUCATIONAL. It is not a price and not a rate card.
# An empty, non-numeric, zero, or negative value gives the default.
FINOPS_EDU_RATE_PER_1K=1.0
